    {
      "parameters": {
        "jsCode": "const raw = $json.choices?.[0]?.message?.content || '{}';\nlet ai;\ntry {\n  ai = JSON.parse(raw);\n} catch (e) {\n  ai = { error: 'Parse error', raw };\n}\n\nconst input = $items('SET - Entrada + Brand JSON')[0].json;\n\nconst compatibilidad = {\n  instagram: ['post_estatico', 'carrusel', 'story', 'guion_reel'],\n  linkedin:  ['post_estatico', 'carrusel'],\n  ambas:     ['post_estatico', 'carrusel'],\n};\n\nconst plataformaKey    = String(input.plataforma || 'Instagram').toLowerCase();\nconst formatoSolicitado = String(input.formato_contenido || 'post_estatico').toLowerCase();\nconst formatosValidos  = compatibilidad[plataformaKey] || compatibilidad.instagram;\nconst formatoFinal     = formatosValidos.includes(formatoSolicitado) ? formatoSolicitado : formatosValidos[0];\n\n// react_data: usa lo que generó el LLM, con fallback por formato\nlet react_data = ai.react_data;\nif (!react_data) {\n  const fmt = ai.formato_contenido || formatoFinal;\n  if (fmt === 'carrusel')    react_data = { slides: ai.slides || [] };\n  else if (fmt === 'story')  react_data = { frames: ai.frames || [] };\n  else if (fmt === 'guion_reel') react_data = { gancho: ai.hook || '', problema: ai.copy || '', puntos: ai.escenas || [], cierre: '', cta: '', duracion: '60 seg' };\n  else react_data = { hook: ai.hook || '', cuerpo: ai.copy || '', cierre: ai.observaciones || '', cta: (ai.caption_instagram || '').slice(0, 120), hashtags: ai.hashtags || [], plataforma: input.plataforma };\n}\n\nconst contentId = String(Date.now());\n\nreturn [{\n  json: {\n    content_id:               contentId,\n    cliente:                  'Megactivo',\n    plataforma:               input.plataforma,\n    formato_contenido:        ai.formato_contenido || formatoFinal,\n    formato_solicitado:       formatoSolicitado,\n    objetivo_post:            input.objetivo_post,\n    fecha_publicacion:        input.fecha_publicacion,\n    hora_publicacion:         input.hora_publicacion,\n    calendar_provider:        input.calendar_provider,\n    brand_json:               input.brand_json,\n    pilar_contenido:          ai.pilar_contenido || '',\n    react_data,\n    caption_instagram:        ai.caption_instagram || '',\n    caption_linkedin:         ai.caption_linkedin  || '',\n    necesita_foto:            Boolean(ai.necesita_foto),\n    prompt_imagen:            ai.prompt_imagen || '',\n    hashtags:                 ai.hashtags || [],\n    observaciones:            ai.observaciones || '',\n    fecha_publicacion_sugerida: ai.fecha_publicacion_sugerida || input.fecha_publicacion,\n    imagen_url:               '',\n    estado:                   'pendiente aprobacion'\n  }\n}];"
      },
