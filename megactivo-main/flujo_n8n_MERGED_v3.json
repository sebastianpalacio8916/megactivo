    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({ model: 'llama-3.3-70b-versatile', temperature: 0.65, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Eres Emiliano, agente senior de contenido para Megactivo. Genera contenido para redes sociales usando el Brand JSON del usuario. Devuelve SOLO JSON valido, sin markdown, sin explicacion adicional.\\n\\nREGLAS:\\n- story y guion_reel: solo Instagram. LinkedIn: solo post_estatico o carrusel. Si el formato no es compatible, corrige al mas cercano.\\n\\nEl JSON debe tener EXACTAMENTE estos campos de primer nivel:\\nformato_contenido, pilar_contenido, caption_instagram, caption_linkedin, hashtags (array), necesita_foto (boolean), prompt_imagen, fecha_publicacion_sugerida, observaciones, react_data.\\n\\nEl campo react_data debe tener la estructura EXACTA segun formato_contenido:\\n\\nSi post_estatico -> react_data={\"hook\":\"gancho impactante 1 frase\",\"cuerpo\":\"desarrollo 2-3 frases\",\"cierre\":\"reflexion o dato de cierre\",\"cta\":\"pregunta o llamada a la accion\",\"hashtags\":[\"#tag1\",\"#tag2\",\"#tag3\"],\"plataforma\":\"Instagram\"}\\n\\nSi carrusel -> react_data={\"slides\":[{\"tipo\":\"hook\",\"texto\":\"titulo impactante\"},{\"tipo\":\"valor\",\"titulo\":\"Titulo punto\",\"cuerpo\":\"Explicacion\"},{\"tipo\":\"valor\",\"titulo\":\"Titulo punto 2\",\"cuerpo\":\"Explicacion 2\"},{\"tipo\":\"remate\",\"texto\":\"Reflexion de cierre\"},{\"tipo\":\"cta\",\"texto\":\"CTA o pregunta\",\"marca\":\"Megactivo\"}]}\\n\\nSi story -> react_data={\"frames\":[{\"tipo\":\"problema\",\"texto\":\"Pregunta o dolor que resuena\",\"poll\":[\"Opcion A\",\"Opcion B\"]},{\"tipo\":\"solucion\",\"texto\":\"La solucion de Megactivo\",\"detalle\":\"Subtitulo o dato de credibilidad\"},{\"tipo\":\"cta\",\"texto\":\"Llamada a la accion concreta\",\"link\":\"megactivo.com\"}]}\\n\\nSi guion_reel -> react_data={\"gancho\":\"Frase gancho 0-3seg\",\"problema\":\"Descripcion del problema 3-8seg\",\"puntos\":[{\"titulo\":\"Punto 1\",\"overlay\":\"Texto en pantalla corto\",\"cuerpo\":\"Voz en off del punto 1\"},{\"titulo\":\"Punto 2\",\"overlay\":\"Texto en pantalla corto\",\"cuerpo\":\"Voz en off del punto 2\"}],\"cierre\":\"Reflexion de cierre\",\"cta\":\"CTA final del reel\",\"duracion\":\"60 seg\"}' }, { role: 'user', content: JSON.stringify({ cliente: $json.cliente, plataforma: $json.plataforma, formato_contenido: $json.formato_contenido, objetivo_post: $json.objetivo_post, fecha_publicacion: $json.fecha_publicacion, calendar_provider: $json.calendar_provider, brand_json: $json.brand_json }) } ] })}}",
        "options": {}
      },
      "id": "9d62b779-96a8-4632-bd87-28c6584a7f1c",
      "name": "HTTP - Groq Llama 3.3 70B",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -896,
        96
      ],
